{
  "manifest_version": 3,
  "name": "OmniScope OSINT — Live Radar, Weather & Sensor Side Panel",
  "short_name": "OmniScope",
  "version": "2.6.0",
  "description": "Real-time Doppler weather radar, USGS earthquakes, NOAA storm alerts, geomagnetic sensors & webcams right in your Chrome Side Panel.",
  "author": "FinnyTech",
  "homepage_url": "https://omniscope-web.vercel.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open OmniScope Tactical Side Panel (Alt+Shift+O)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://archive-api.open-meteo.com/*",
    "https://api.rainviewer.com/*",
    "https://tilecache.rainviewer.com/*",
    "https://earthquake.usgs.gov/*",
    "https://api.weather.gov/*",
    "https://services.swpc.noaa.gov/*",
    "https://api.wheretheiss.at/*",
    "https://omniscope-web.pages.dev/*",
    "https://omniscope-web.vercel.app/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open OmniScope Tactical Side Panel"
    }
  }
}
